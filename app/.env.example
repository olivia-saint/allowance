# Solana devnet addresses / keys for the Allowance demo.
# Copy to .env.local and fill in. NEVER commit .env.local.

# RPC endpoint (devnet only)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Devnet keypairs (base58 secret keys). Generated by: node scripts/keygen.mjs
# The business key pays transaction fees; agent keys never need SOL.
OWNER_SECRET=
AGENT_OPS_SECRET=
AGENT_RESEARCH_SECRET=
MINT_SECRET=

# Merchant wallets (devnet keypairs)
MERCHANT_DATA_SECRET=
MERCHANT_ROOMS_SECRET=
MERCHANT_SUPPLY_SECRET=

# Public addresses (derived by: node scripts/derive-env.mjs)
MINT_ADDRESS=
MERCHANT_DATA_ADDRESS=
MERCHANT_ROOMS_ADDRESS=
MERCHANT_SUPPLY_ADDRESS=

# Secret used to HMAC-sign memo receipts so third parties cannot forge ledger entries.
REFERENCE_SECRET=

# Public origin, used when the agent calls its own merchant endpoints.
PUBLIC_ORIGIN=
